# Aplicação hospedada na Vercel: configure estas variáveis no painel da Vercel.
# Copie a URL em Supabase > Connect > Transaction pooler; não use a URL pública do projeto.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_POOLER_SUPABASE:6543/postgres
NODE_ENV=production
# Apenas se a cadeia TLS exigir o CA disponibilizado pelo Supabase.
# SUPABASE_DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Alternativa: Vercel + MySQL externo, após habilitar acesso remoto e TLS na hospedagem.
# DATABASE_URL=mysql://vmcomunica_admin:SENHA_CODIFICADA@186.209.113.107:3306/vmcomunica_sisroteiro
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Em uma aplicação executada no próprio cPanel, o host MySQL pode ser localhost.
