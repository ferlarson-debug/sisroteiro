# MySQL local no cPanel (use o nome completo com prefixo da conta).
# Codifique caracteres especiais do usuário/senha para URL.
DATABASE_URL=mysql://CONTA_USUARIO:SENHA_CODIFICADA@localhost:3306/CONTA_BANCO
NODE_ENV=production
# Habilite apenas com Apache/Passenger como único proxy confiável.
TRUST_PROXY=1
# Banco MySQL remoto usa TLS verificado automaticamente.
# MYSQL_SSL=true
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Alternativa preservada: PostgreSQL/Supabase.
# DATABASE_URL=postgresql://USUARIO:SENHA_CODIFICADA@HOST_POOLER:6543/postgres
# SUPABASE_DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
